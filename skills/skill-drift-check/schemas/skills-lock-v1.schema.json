{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/manangoyal21/skill-drift-check/master/skills/skill-drift-check/schemas/skills-lock-v1.schema.json",
  "title": "driftcheck skills.lock v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "workspace",
    "generatedBy",
    "hashPolicy",
    "skills"
  ],
  "properties": {
    "format": { "const": "driftcheck-lock" },
    "version": { "const": 1 },
    "workspace": {
      "type": "object",
      "required": ["id", "createdAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "generatedBy": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "skill-drift-check" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "hashPolicy": { "const": "tree-sha256-v1" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "identity",
          "name",
          "source",
          "targets",
          "digest",
          "syncable"
        ],
        "properties": {
          "identity": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "path"],
                "properties": {
                  "type": { "const": "local" },
                  "path": { "$ref": "#/$defs/projectPath" }
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": ["type", "url", "revision", "path"],
                "properties": {
                  "type": { "const": "git" },
                  "url": {
                    "type": "string",
                    "pattern": "^(?:https://|ssh://|git@[^:]+:)"
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                  },
                  "path": { "$ref": "#/$defs/sourcePath" }
                },
                "additionalProperties": true
              }
            ]
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["tool", "path"],
              "properties": {
                "tool": {
                  "enum": ["agents", "claude-code", "cursor"]
                },
                "path": {
                  "type": "string",
                  "pattern": "^(?:\\.agents|\\.claude|\\.cursor)/skills/[^/]+$"
                }
              },
              "allOf": [
                {
                  "if": { "properties": { "tool": { "const": "agents" } } },
                  "then": {
                    "properties": {
                      "path": { "pattern": "^\\.agents/skills/[^/]+$" }
                    }
                  }
                },
                {
                  "if": { "properties": { "tool": { "const": "claude-code" } } },
                  "then": {
                    "properties": {
                      "path": { "pattern": "^\\.claude/skills/[^/]+$" }
                    }
                  }
                },
                {
                  "if": { "properties": { "tool": { "const": "cursor" } } },
                  "then": {
                    "properties": {
                      "path": { "pattern": "^\\.cursor/skills/[^/]+$" }
                    }
                  }
                }
              ],
              "additionalProperties": true
            }
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "syncable": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "properties": { "type": { "const": "local" } },
                  "required": ["type"]
                }
              }
            },
            "then": { "properties": { "syncable": { "const": false } } }
          },
          {
            "if": {
              "properties": {
                "source": {
                  "properties": { "type": { "const": "git" } },
                  "required": ["type"]
                }
              }
            },
            "then": { "properties": { "syncable": { "const": true } } }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.\\.?$)(?!/)(?![A-Za-z]:)(?!~\\/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//).+$"
    },
    "sourcePath": {
      "anyOf": [
        { "const": "." },
        { "$ref": "#/$defs/projectPath" }
      ]
    }
  },
  "additionalProperties": true
}
